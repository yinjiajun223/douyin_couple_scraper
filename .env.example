# 复制为 .env 后填写真实值。示例占位值会被启动校验拒绝。
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=mysql://douyin_app:<replace-me>@<rds-endpoint>:3306/douyin_ops?ssl-mode=REQUIRED
MIGRATION_DATABASE_URL=mysql://douyin_migrator:<replace-me>@<rds-endpoint>:3306/douyin_ops?ssl-mode=REQUIRED
RDS_ALLOWED_CIDRS=<server-public-ip>/32
SESSION_SECRET=<generate-at-least-32-random-characters>
CREDENTIAL_ENCRYPTION_KEY=<generate-at-least-32-random-characters>
OSS_ENDPOINT=https://<bucket>.<region>.aliyuncs.com
OSS_REGION=<region>
OSS_BUCKET=<private-bucket>
OSS_ACCESS_KEY_ID=<replace-me>
OSS_ACCESS_KEY_SECRET=<replace-me>
OSS_BUCKET_PRIVATE=true
OSS_READINESS_PROBE=true
COLLECTOR_MIN_VERSION=0.1.0
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
MEDIA_RETENTION_DAYS=180
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_CLEANUP_INTERVAL_MS=3600000

# Collector 单独使用下列配置；设备令牌由配对流程生成，不应写入共享文件。
COLLECTOR_API_BASE_URL=https://<your-domain>
COLLECTOR_DATA_DIR=./collector-data
COLLECTOR_CONTROL_PORT=43127
