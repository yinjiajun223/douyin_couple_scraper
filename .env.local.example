# 本地开发配置。复制为 .env.local；不要把真实密钥提交到 Git。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=mysql://douyin_dev:local-dev-password@127.0.0.1:33306/douyin_ops_dev
SESSION_SECRET=local-debug-session-secret-2026-at-least-32-characters

# 首轮页面调试不连接 OSS。测试截图直传时替换为私有 OSS 的真实配置，
# 并将 OSS_READINESS_PROBE 改为 true。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=local-debug-private-bucket
OSS_ACCESS_KEY_ID=local-debug-access-id
OSS_ACCESS_KEY_SECRET=local-debug-access-secret-2026
OSS_BUCKET_PRIVATE=true
OSS_READINESS_PROBE=false

COLLECTOR_MIN_VERSION=0.1.0
WORKER_ID=local-worker-1
MEDIA_RETENTION_DAYS=180
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_CLEANUP_INTERVAL_MS=3600000

COLLECTOR_API_BASE_URL=http://127.0.0.1:3000
COLLECTOR_DATA_DIR=./.local/collector-data
COLLECTOR_CONTROL_PORT=43127
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# 仅用于本地数据库首次初始化。重复执行 dev:setup 不会重复创建管理员。
BOOTSTRAP_WORKSPACE_NAME=本地调试工作区
BOOTSTRAP_WORKSPACE_SLUG=local-debug
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_DISPLAY_NAME=本地管理员
BOOTSTRAP_ADMIN_PASSWORD=LocalDebugAdmin2026
